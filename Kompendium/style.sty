%%%%%%%%%%%%%%%%%%%TCBox for definisjoner%%%%%%%%%%%%%%%%%%%%%
\definecolor{defnFarge}{rgb}{0.3,0.4,0}
\newtcolorbox[auto counter, number within=chapter]{defn}[2][Definisjon ]{%
colback=defnFarge!4,
  colframe=defnFarge!10,
  leftrule=2pt,
  rightrule=0pt,
  toprule=0pt,
  bottomrule=0pt,
  coltitle=black,
  fonttitle=\itshape,
  breakable,
  enhanced,
  title={#1\ifstrempty{#2}{}~\thetcbcounter\,{\normalfont\bfseries\small(#2)}}%
}

%%%%%%%% TCBteorem-boks for teoremer %%%%%%
\definecolor{thmFarge}{rgb}{0,0,0.7}
\newtcbtheorem[auto counter, number within=chapter]{thrm}{Teorem}{%
colback=thmFarge!2,
  colframe=thmFarge!5,
  leftrule=2pt,
  rightrule=0pt,
  toprule=0pt,
  bottomrule=0pt,
  coltitle=black,
  fonttitle=\itshape,
  breakable,
  enhanced,
}{th}

\RenewDocumentCommand{\th}{m+m}{
    \begin{thrm}{#1}{}
        #2
    \end{thrm}
}

\NewDocumentCommand{\thr}{mm+m}{
    \begin{thrm}{#1}{#2}
        #3
    \end{thrm}
}


